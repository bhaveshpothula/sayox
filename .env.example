# ============ SAFETY (defaults are SAFE — do not enable until tested) ============
BOT_ENABLED=false
DRY_RUN=true
AUTO_POST=false

# Rate limits
MAX_TWEETS_PER_HOUR=5
MAX_TWEETS_PER_DAY=50

# AI (optional fallback — keep disabled for zero-token operation)
AI_ENABLED=false
AI_DAILY_LIMIT=20

# Scheduler
POLL_INTERVAL_SECONDS=900

# ============ PUBLISHING WORKFLOW (dashboard recommendation engine) ============
# After a post is marked posted, no new recommendation until this expires
NEWS_COOLDOWN_MINUTES=60
# A story about a just-posted topic is suppressed for this long
TOPIC_COOLDOWN_MINUTES=180
# Quality gate: stories below this publish score are never recommended
MIN_PUBLISH_SCORE=70
# A new story must beat the current recommendation by this much to replace it
MIN_SCORE_IMPROVEMENT=10
# Local-time posting windows (display guidance only; never blocks breaking news)
POSTING_WINDOWS=08:00-10:00,12:00-14:00,17:00-20:00
# Breaking override during cooldown (all three bars must clear, 0-100)
BREAKING_IMPORTANCE=90
BREAKING_MOMENTUM=90
BREAKING_FRESHNESS=90
# Major-new-development override for the topic cooldown (0-100)
MAJOR_DEV_IMPORTANCE=90
MAJOR_DEV_FRESHNESS=90
# Hashtag policy: 0 default, 1 preferred, 2 absolute maximum
MAX_HASHTAGS=2

# ============ X API (official API only — never commit real values) ============
# Create an app at https://developer.x.com (Project & App → Keys and Tokens).
# You need ALL FOUR values, generated with "Read and write" permissions.
#
# API Key and Secret          → "Consumer Keys" section (X_API_KEY / X_API_SECRET)
# Access Token and Secret     → "Authentication Tokens" section — regenerate with
#                               App permissions set to "Read and write" FIRST
#                               (tokens generated while read-only stay read-only).
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
